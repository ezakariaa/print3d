PROJECT_ID=
STORAGE_BUCKET=
# Firestore database ID shown in the console. Leave empty for the "(default)" database.
FIRESTORE_DATABASE_ID=
ADMIN_EMAIL=
# Path to a Firebase service account key JSON for local development.
# Download it from Firebase Console > Project settings > Service accounts > Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional when the site and API are deployed on different origins.
CLIENT_ORIGIN=
